<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GameVault;assembly=GameVault"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Background="#0B0E14"
    Foreground="#E6EDF3"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

  <UserControl.Resources>

    <!-- ============ 基础色板 ============ -->
    <SolidColorBrush x:Key="BgRoot"      Color="#0B0E14"/>
    <SolidColorBrush x:Key="BgPanel"     Color="#11161F"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161D27"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#1E2734"/>
    <SolidColorBrush x:Key="BorderSoft"  Color="#222B39"/>
    <SolidColorBrush x:Key="TextMain"    Color="#E6EDF3"/>
    <!-- 次要文字（开发商名、时长数值等）。卡片背景 #161D27 上约 12.6:1 -->
    <SolidColorBrush x:Key="TextDim"     Color="#D6DFE9"/>
    <!-- 小标签（"库存总数""总游戏时长""开发商"等）。
         对比度演进：#5A6673（2.89:1，几乎看不清）→ #9AA8B8（6.99:1）→ 现在 #C1CDDB。
         现在：根背景 12.0:1 / 面板 11.2:1 / 卡片 10.5:1；同时全站字号 +1px。 -->
    <SolidColorBrush x:Key="TextFaint"   Color="#C1CDDB"/>
    <SolidColorBrush x:Key="Accent"      Color="#4CC2FF"/>

    <!-- ============ 滚动条 ============ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <!-- 热区占满整条（14px），视觉上只是中间一根细条，好抓取 -->
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Border x:Name="Bar" Background="#39465A" CornerRadius="4"
                                  Width="8" HorizontalAlignment="Center" Margin="0,3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#4CC2FF"/>
                            <Setter TargetName="Bar" Property="Width" Value="10"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#4CC2FF"/>
                            <Setter TargetName="Bar" Property="Width" Value="10"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="14"/>
          <Setter Property="Width" Value="Auto"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter Grid.Column="0"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                         Orientation="Vertical" Style="{StaticResource SlimScrollBar}"
                         Value="{TemplateBinding VerticalOffset}"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 细分隔进度条 ============ -->
    <Style x:Key="TinyBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Background" Value="#1C2530"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="1.5">
              <Grid>
                <Border x:Name="PART_Track" Background="Transparent"/>
                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 细滑块（缩放条） ============ -->
    <Style x:Key="SlimSlider" TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" VerticalAlignment="Center">
              <Border Height="3" CornerRadius="1.5" Background="#2E3A4A" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb Width="13" Height="13" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Fill="#4CC2FF" Width="13" Height="13"/>
                          <Ellipse Fill="#0B0E14" Width="5" Height="5"/>
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 顶部工具按钮 ============ -->
    <Style x:Key="SegButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- 外层透明 Grid：Border 的 CornerRadius 会让四个圆角之外的区域不参与命中测试，
                 套一层透明 Grid 才能做到"整块矩形都可点" -->
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Foreground" Value="#0B0E14"/>
          <Setter Property="Background" Value="{StaticResource Accent}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="1"
                      BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 语言下拉框 ============ -->
    <Style x:Key="LangComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ClickMode" Value="Press"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <!-- 外层透明 Grid：Border 的 CornerRadius 会让圆角之外不参与命中测试，
                 套一层才能做到整个矩形都可点（排序按钮当初就是踩的这个坑） -->
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="#151C26" BorderBrush="{StaticResource BorderSoft}"
                      BorderThickness="1" CornerRadius="6">
                <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="#8593A3" StrokeThickness="1.3"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,0" Padding="9,5">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2735"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#0B0E14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Width" Value="98"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource LangComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Style="{StaticResource LangComboToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     PopupAnimation="Slide" VerticalOffset="3">
                <Border Background="#151C26" BorderBrush="#2C3849" BorderThickness="1"
                        CornerRadius="7" Padding="0,4" MinWidth="98">
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 搜索框 ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#151C26"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="30,0,28,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13" Foreground="{StaticResource TextFaint}"
                           VerticalAlignment="Center" Margin="11,0,0,0"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Hint" Text="{DynamicResource LocSearchHint}" Foreground="{StaticResource TextFaint}"
                           FontSize="13.5" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Text" Value="{x:Null}">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 表单输入框（AI 配置用） ============ -->
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#0E141C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{StaticResource BorderSoft}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#33445A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 概览卡片 ============ -->
    <Style x:Key="StatCard" TargetType="Border">      <Setter Property="Background" Value="{StaticResource BgPanel}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
    </Style>

    <!-- ============ 列表容器 ============ -->
    <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 悬停详情内容（网格 / 条形共用） ============ -->
    <DataTemplate x:Key="DetailCardTemplate">
      <Border Width="400" Background="#101720" CornerRadius="12"
              BorderThickness="1" BorderBrush="#2C3849" Padding="0">
        <StackPanel>
          <!-- 海报：完整显示整张图（不裁切），高度随图片比例自适应。这里有两个坑：
               1) 图片用 ImageBrush 画在圆角 Border 的**背景**上，而不是用 Image 控件 ——
                  WPF 只把 Border 自己绘制的背景裁成圆角，子元素（Image）是直角地溢出到
                  圆角之外的，否则会出现「外面框是圆角、里面图片是直角」。
               2) **不能设 MinHeight**。超宽图（例如 1920x620 的 hero 图）按容器宽度 398
                  算出来只有 128px 高，一旦用 MinHeight 把容器撑到 150，多出来的 21px 就会
                  让图片上下各留一条约 11px 的黑边 —— 这就是「海报最上方有黑边」的成因。
                  所以高度完全交给图片决定（里面那个 Visibility=Hidden 的 Image 撑开），
                  只保留 MaxHeight，防止竖版海报把卡片撑得过高。 -->
          <Border CornerRadius="12,12,0,0" Background="#0D1219" MaxHeight="330">
            <Grid>
              <Border CornerRadius="12,12,0,0">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Poster}" Stretch="Uniform"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
                <Image Source="{Binding Poster}" Stretch="Uniform" MaxHeight="330"
                       Visibility="Hidden"/>
              </Border>
              <Rectangle Height="90" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#E6101720" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Bottom" Margin="14,0,14,10"
                         TextTrimming="CharacterEllipsis" MaxHeight="46" TextWrapping="Wrap"/>
            </Grid>
          </Border>

          <StackPanel Margin="14,10,14,13">
            <!-- 徽章行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <Border CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                      Background="{Binding ScoreBrush}" Opacity="0.92">
                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0B0E14">
                  <Run Text="Metacritic "/><Run Text="{Binding ScoreText, Mode=OneWay}"/>
                </TextBlock>
              </Border>
              <ItemsControl ItemsSource="{Binding Badges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                            BorderThickness="1" BorderBrush="{Binding Color}">
                      <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{Binding Color}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 开发商 / 发行商。标签列用 Auto 自适应宽度（中文"开发商"窄、英文"Developer"宽），
                 否则英文标签会顶到后面的公司名上 -->
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LocDeveloper}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,0,14,0"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Developers}" FontSize="13" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LocPublisher}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,3,14,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Publishers}" FontSize="13" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </Grid>

            <!-- 时长数据 -->
            <Border Background="#161E29" CornerRadius="8" Padding="11,9" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="{DynamicResource LocTotalTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding TotalLongText}" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Text="{DynamicResource LocRecentTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding RecentLongText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource LocLastPlayed}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding LastPlayedText}" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource LocReleased}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding ReleaseText}" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextDim}"
                       TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 网格卡片 ============ -->
    <DataTemplate x:Key="GameCardTemplate">
      <Border x:Name="CardRoot"
              Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Margin="0,0,10,10"
              Background="{StaticResource BgCard}"
              CornerRadius="9"
              BorderThickness="1"
              BorderBrush="{StaticResource BorderSoft}"
              Cursor="Hand"
              SnapsToDevicePixels="True">
        <Border.ToolTip>
          <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False"
                   Placement="Mouse" HorizontalOffset="16" VerticalOffset="12"
                   ToolTipService.InitialShowDelay="60" ToolTipService.ShowDuration="60000">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailCardTemplate}"/>
          </ToolTip>
        </Border.ToolTip>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="22"/>
          </Grid.RowDefinitions>

          <!-- 封面 -->
          <Border Grid.Row="0" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#0E141C"
                  Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid>
              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextFaint}"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="10"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <!-- 封面用 ImageBrush 画在圆角 Border 的背景上，四角才会跟卡片一起圆
                   （用 Image 控件时图片是直角，会溢出到圆角之外）。
                   它排在兜底文字之后，所以仍然盖住文字；后面的平台徽章和评分圈又盖在它上面。 -->
              <Border CornerRadius="9,9,0,0">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
              </Border>

              <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,0,4"
                            Background="#CC0B0E14" BorderThickness="1" BorderBrush="{Binding Color}">
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border CornerRadius="14" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right"
                      Margin="0,6,6,0" Background="#D90B0E14" BorderThickness="1.5" BorderBrush="{Binding ScoreBrush}">
                <TextBlock Text="{Binding ScoreText}" FontSize="13.5" FontWeight="Bold"
                           Foreground="{Binding ScoreBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

            </Grid>
          </Border>

          <!-- 名称 -->
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMain}" Margin="8,7,8,0"
                     TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap"/>

          <!-- 时长行。这一行的高度压到 22px（原来 28）：内容只有「时长文字 17px +
               底部强度条 4px」，28px 会让卡片下沿多挂一截约 7px 的纯空白。
               文字区的下边距留 4px 给强度条，两者不重叠。 -->
          <Grid Grid.Row="2" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="12.5"
                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                  <Setter Property="Text" Value="{DynamicResource LocNotRecently}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRecent}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                      <Setter Property="Text" Value="{Binding RecentText}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <ProgressBar Grid.Row="2" Style="{StaticResource TinyBar}" VerticalAlignment="Bottom"
                       Margin="1,0,1,1" Value="{Binding RecentPercent, Mode=OneWay}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource BgCardHover}"/>
          <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ 条形（列表）行 ============ -->
    <DataTemplate x:Key="BarRowTemplate">
      <Border x:Name="BarRoot"
              Margin="0,0,4,6"
              Background="{StaticResource BgCard}"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{StaticResource BorderSoft}"
              Padding="10,8"
              Cursor="Hand"
              SnapsToDevicePixels="True">
        <Border.ToolTip>
          <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False"
                   Placement="Mouse" HorizontalOffset="16" VerticalOffset="12"
                   ToolTipService.InitialShowDelay="60" ToolTipService.ShowDuration="60000">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailCardTemplate}"/>
          </ToolTip>
        </Border.ToolTip>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="44" Height="58" CornerRadius="5" ClipToBounds="True" Background="#0E141C">
            <Grid>
              <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                         Margin="3" VerticalAlignment="Center" TextAlignment="Center"/>
              <!-- 同上：条形视图的小封面也走圆角 Border 的背景，四角才跟外框一致 -->
              <Border CornerRadius="5">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,5,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0"
                          Background="#150B0E14" BorderThickness="1" BorderBrush="{Binding Color}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Color}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 中间空白区：直接展示开发商 / 发行商 -->
          <TextBlock Grid.Column="2" Text="{Binding DevPubText}" FontSize="12.5"
                     Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                     Margin="22,0,26,0" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource LocRecentTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
              <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                    <Setter Property="Text" Value="{DynamicResource LocNone}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRecent}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        <Setter Property="Text" Value="{Binding RecentLongText}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ProgressBar Style="{StaticResource TinyBar}" Margin="0,6,0,0"
                         Value="{Binding RecentPercent, Mode=OneWay}"/>
          </StackPanel>

          <Border Grid.Column="4" CornerRadius="17" Width="34" Height="34" VerticalAlignment="Center"
                  Margin="0,0,16,0" Background="#D90B0E14" BorderThickness="1.5"
                  BorderBrush="{Binding ScoreBrush}">
            <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold"
                       Foreground="{Binding ScoreBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Grid.Column="5" Text="{Binding TotalText}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMain}" VerticalAlignment="Center"
                     MinWidth="82" TextAlignment="Right"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="BarRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="BarRoot" Property="Background" Value="{StaticResource BgCardHover}"/>
          <Setter TargetName="BarRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ 列表面板：网格用换行面板，条形用虚拟化栈 ============ -->
    <ItemsPanelTemplate x:Key="WrapItemsPanel">
      <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="StackItemsPanel">
      <VirtualizingStackPanel/>
    </ItemsPanelTemplate>

  </UserControl.Resources>

  <Grid Background="{StaticResource BgRoot}">
    <!-- 库存页与分析页叠在同一格里，靠 Visibility 切换。
         用 Visibility 而不是两个独立 UserControl：切回来时 ListBox 的滚动位置、
         已解码的封面图全都还在，不会重排一次。 -->
    <Grid x:Name="VaultPage">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

    <!-- ============ 顶部栏 ============ -->
    <!-- 顶部工具栏。
         注意下面几处 shell:WindowChrome.IsHitTestVisibleInChrome="True"：
         Playnite 窗口启用了 WindowChrome，FusionX 主题的 CaptionHeight 是 24px，
         即窗口最顶部 24px 属于"标题栏拖拽区"，鼠标事件会被窗口本身吃掉、不传给插件。
         本工具栏高 54px、控件垂直居中（约 y=10~44），控件有一大半落在该区域内，
         于是表现为"只有鼠标放在控件偏下的位置才点得中"。
         给交互控件（及其所在容器）声明该属性后，这块区域按客户区处理，任意位置都可点；
         而工具栏中控件以外的空白仍保持标题栏行为，依然可以用来拖动窗口。 -->
    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSoft}" Padding="16,0">
      <Grid Height="54">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：图标 / 标题 / 计数 / 语言切换。
             这里用 Grid 而不是 StackPanel —— 标题那一列是 *，窗口变窄时它会先被压成省略号，
             整块内容因此永远不会溢出到中间列去遮挡搜索框。
             （用 StackPanel 时内容宽度固定，会盖住中间列，导致语言下拉框点不中。） -->
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="17" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{DynamicResource LocTitle}" FontSize="16.5" FontWeight="SemiBold"
                     Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="2" Background="#1C2634" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding EntryCountText}" FontSize="13" Foreground="{StaticResource TextDim}"/>
          </Border>

          <!-- 语言切换（中文 / English） -->
          <ComboBox Grid.Column="3" x:Name="LanguageBox" Style="{StaticResource LangCombo}" Margin="12,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="{DynamicResource LocTipLanguage}">
            <ComboBoxItem Content="中文"/>
            <ComboBoxItem Content="English"/>
          </ComboBox>
        </Grid>

        <!-- 搜索 + 排序 + 视图工具：整组居中。
             整组声明 IsHitTestVisibleInChrome —— 子元素会沿视觉树向上继承该判定，
             因此搜索框、三个排序按钮、两个图标按钮全部覆盖，无需逐个添加。
             右侧刻意留空 —— Playnite 自己的最小化/关闭按钮就在窗口右上角，放这儿会重叠。 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" Width="180" Margin="0,0,14,0"/>
          <Border Background="#151C26" CornerRadius="8" Padding="0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SortTotal"  Style="{StaticResource SegButton}" Content="{DynamicResource LocSortTotal}" Tag="Active"/>
              <Button x:Name="SortRecent" Style="{StaticResource SegButton}" Content="{DynamicResource LocSortRecent}"/>
              <Button x:Name="SortScore"  Style="{StaticResource SegButton}" Content="{DynamicResource LocSortScore}"/>
            </StackPanel>
          </Border>
          <Border Width="1" Height="20" Background="{StaticResource BorderSoft}" Margin="12,0"/>
          <Button x:Name="ViewToggleButton" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LocTipList}" Margin="0,0,8,0"/>
          <Button x:Name="ShareButton" Style="{StaticResource IconButton}" Content="&#xE72D;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                  ToolTip="{DynamicResource LocTipShareImage}" Margin="0,0,8,0"/>
          <Button x:Name="AnalyzeButton" Style="{StaticResource IconButton}" Content="&#xE9D9;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LocTipAnalyze}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 概览卡片 ============ -->
    <Border Grid.Row="1" Padding="16,12,16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatGames}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding EntryCountText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding RawCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatPlaytime}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding TotalPlaytimeText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding PlayedCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatRecent}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding RecentPlaytimeText}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ActiveCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatTop}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding TopGameName}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding TopGameTimeText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatScore}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding AverageScoreText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ScoredCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============ 游戏列表 ============ -->
    <Grid Grid.Row="2">
      <ListBox x:Name="GameList"
               Background="Transparent"
               BorderThickness="0"
               Padding="16,0,6,64"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="False"
               ItemContainerStyle="{StaticResource RowItemStyle}"
               HorizontalContentAlignment="Stretch"
               ItemsPanel="{StaticResource WrapItemsPanel}"
               ItemTemplate="{StaticResource GameCardTemplate}"/>

      <TextBlock x:Name="EmptyHint" Text="{DynamicResource LocEmpty}" FontSize="15" Foreground="{StaticResource TextFaint}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

      <Border x:Name="LoadingMask" Background="#F20B0E14" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource LocLoading}" FontSize="15" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,12,0,0" Foreground="{StaticResource Accent}"
                       Background="#1C2530" BorderThickness="0"/>
        </StackPanel>
      </Border>

      <!-- ============ 右下角缩放条 ============ -->
      <!-- 右下角缩放条。窗口的 ResizeBorderThickness 为 16px，即窗口四边 16px 内是"调整窗口大小"区，
           同样会吃掉鼠标事件；距右/下边缘 28/24px 已在其外，这里再声明一次作为保险。 -->
      <Border x:Name="ZoomPanel"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,28,24"
              Height="32"
              Padding="11,0"
              Background="#F0182130"
              CornerRadius="16"
              BorderThickness="1"
              BorderBrush="#33415A"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Cursor="Hand">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="0.85"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x2212;" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Margin="0,0,8,0" IsHitTestVisible="False"/>
          <Slider x:Name="ZoomSlider"
                  Style="{StaticResource SlimSlider}"
                  Width="122"
                  Minimum="118"
                  Maximum="268"
                  Value="172"
                  SmallChange="4"
                  LargeChange="18"/>
          <TextBlock Text="+" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Margin="8,0,0,0" IsHitTestVisible="False"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ 状态栏 ============ -->
    <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource BgPanel}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSoft}" Padding="16,0">
      <Grid Height="26">
        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SourceText" Text="{Binding SourceText}" FontSize="13" Foreground="{StaticResource TextFaint}"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>
    </Grid>

    <!-- ============ 数据分析页 ============ -->
    <Grid x:Name="AnalyzePage" Visibility="Collapsed" Background="{StaticResource BgRoot}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 顶栏：一律「靠左 + 居中」两段，绝不把功能按钮挤到最右侧。
           原因：窗口右上角是系统的最小化/最大化/关闭按钮所在的标题栏区域，
           放过去的按钮会与它们抢鼠标（实测点不到），所以功能性按钮统一居中。
           整条容器声明 chrome 穿透，否则落在 CaptionHeight 区内的按钮点不中。 -->
      <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderThickness="0,0,0,1"
              BorderBrush="{StaticResource BorderSoft}" Padding="16,0"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Height="54">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- 左：返回 + 标题 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}"
                    Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="{DynamicResource LocTipBack}" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="17" Foreground="{StaticResource Accent}" Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="AnalyzeTitleText" Text="{DynamicResource LocAnalyzeTitle}" FontSize="16.5"
                       FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
          </StackPanel>

          <!-- 中：全部功能性按钮。新增按钮只需往这个 StackPanel 里加，
               它会始终保持在窗口水平中央，不会撞上右上角的系统按钮。 -->
          <StackPanel x:Name="AnalyzeToolBar" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 文风切换：锐评 / 正式 -->
            <Border Background="#151C26" CornerRadius="8" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ToneSnarky" Style="{StaticResource SegButton}"
                        Content="{DynamicResource LocStyleSnarky}" Tag="Active"
                        ToolTip="{DynamicResource LocTipReportStyle}"/>
                <Button x:Name="ToneFormal" Style="{StaticResource SegButton}"
                        Content="{DynamicResource LocStyleFormal}"
                        ToolTip="{DynamicResource LocTipReportStyle}"/>
              </StackPanel>
            </Border>
            <Button x:Name="AnalyzeCopyButton" Style="{StaticResource IconButton}"
                    Content="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="{DynamicResource LocTipCopyShare}"/>
          </StackPanel>

          <!-- 右：留白，什么都不放（避免与系统按钮重叠） -->
          <Border Grid.Column="2" Width="120"/>
        </Grid>
      </Border>

      <!-- 正文：整体可滚动。
           三块内容用 Grid + GridSplitter 排布，用户可以拖动分隔条自由调整各视窗大小。 -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="16,14,16,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 副标题 -->
          <TextBlock x:Name="AnalyzeSubtitle" Grid.Row="0" FontSize="13.5"
                     Foreground="{StaticResource TextFaint}" Margin="2,0,0,10"
                     TextWrapping="Wrap"/>

          <Grid x:Name="AnalyzeLayout" Grid.Row="1">
            <Grid.RowDefinitions>
              <!-- 第一排：饼图 + Top 50（高度可拖）。默认给到 420，让饼图有足够空间。
                   GridSplitter 的 ResizeBehavior 默认是 PreviousAndNext，所以拖这里是
                   从报告区借高度，饼图不会被压扁。 -->
              <RowDefinition x:Name="RowTop" Height="420" MinHeight="240"/>
              <!-- 横向分隔条 -->
              <RowDefinition Height="Auto"/>
              <!-- 第二排：游玩时间轴（固定高度，内容本身就是横向铺满） -->
              <RowDefinition Height="Auto"/>
              <!-- 第三排：报告（含推荐），高度可拖 -->
              <RowDefinition x:Name="RowReport" Height="*" MinHeight="220"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <!-- 饼图列：宽度可拖。默认给得比较宽（原 420 显得挤，饼图和图例都憋屈） -->
                <ColumnDefinition x:Name="ColGenre" Width="520" MinWidth="300"/>
                <!-- 竖向分隔条 -->
                <ColumnDefinition Width="Auto"/>
                <!-- Top 50 列 -->
                <ColumnDefinition x:Name="ColTop" Width="*" MinWidth="280"/>
              </Grid.ColumnDefinitions>

              <!-- 类型分布 -->
              <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="16,14" Margin="0,0,10,10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Orientation="Horizontal">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource LocPanelGenres}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource LocPanelGenresSub}" FontSize="12" Margin="0,3,0,0"
                               Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" MaxWidth="260"/>
                  </StackPanel>
                  <Border x:Name="GenreBasisToggle" Background="#151C26" CornerRadius="7" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="BasisTime" Style="{StaticResource SegButton}" Tag="Active"
                              Content="{DynamicResource LocBasisTime}"/>
                      <Button x:Name="BasisCount" Style="{StaticResource SegButton}"
                              Content="{DynamicResource LocBasisCount}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- 空状态提示：没有类型数据时盖上，避免出现一个空圈 -->
                <StackPanel x:Name="GenreEmptyHint" Grid.Row="1" Grid.RowSpan="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Margin="0,24,0,0">
                  <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="34" Foreground="#3A4759" HorizontalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource LocNoGenreData}" FontSize="14" Margin="0,10,0,0"
                             Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource LocNoGenreHint}" FontSize="12" Margin="0,5,0,0"
                             Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                             TextWrapping="Wrap" TextAlignment="Center" MaxWidth="290"/>
                </StackPanel>

                <!-- 饼图尺寸跟随可用空间（Stretch 由 PieChart 自己按 Min(宽,高) 取直径）。
                     MinWidth/MinHeight 给得比较大：用户反馈原来"看着很挤"，
                     所以默认就让它占满左列的整个高度，只在面板被拖得很小时才收缩。 -->
                <Grid x:Name="GenreChartArea" Grid.Row="2" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColChart" Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <local:PieChart x:Name="GenreChart" Grid.Column="0" Thickness="38"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  MinWidth="200" MinHeight="200"/>

                  <!-- 图例：点一下只看该类型 -->
                  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="14,4,0,0">
                    <ItemsControl x:Name="GenreLegend">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="LegendRow" Background="Transparent" CornerRadius="6"
                                  Padding="6,5" Margin="0,0,0,1" Cursor="Hand">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                                      Background="{Binding Color}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                         Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                         Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="12.5"
                                         FontWeight="SemiBold" Foreground="{Binding Color}"
                                         VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                          <DataTemplate.Triggers>
                            <Trigger SourceName="LegendRow" Property="IsMouseOver" Value="True">
                              <Setter TargetName="LegendRow" Property="Background" Value="#1E2734"/>
                            </Trigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>

            <!-- 竖向分隔条：拖它改「饼图 / Top 50」的宽度比 -->
            <GridSplitter x:Name="SplitV" Grid.Column="1" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Margin="0,0,0,10"
                          Background="Transparent" ShowsPreview="False"
                          Cursor="SizeWE" ToolTip="{DynamicResource LocTipSplitV}">
              <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                  <Border Background="Transparent">
                    <Border Width="3" CornerRadius="2" Background="#26313F" x:Name="Grip"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Grip" Property="Background" Value="#4CC2FF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </GridSplitter.Template>
            </GridSplitter>

            <!-- 时长 Top 50 -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="16,14" Margin="10,0,0,10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                  <TextBlock Text="{DynamicResource LocPanelTop}" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock x:Name="Top50Subtitle" FontSize="12" Margin="0,3,0,0"
                             Foreground="{StaticResource TextFaint}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" MinHeight="120">
                  <ItemsControl x:Name="Top50List">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,2" Height="30">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <!-- 名次 -->
                          <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12.5"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"
                                     VerticalAlignment="Center"/>

                          <!-- 小封面（走 Border 背景才能跟圆角一致） -->
                          <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                  Background="#0E141C" VerticalAlignment="Center">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding Entry.Cover}" Stretch="UniformToFill"
                                          RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                          </Border>

                          <TextBlock Grid.Column="2" Text="{Binding Entry.Name}" FontSize="13"
                                     Foreground="{StaticResource TextMain}" Margin="9,0,10,0"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                          <!-- 占比条：一眼看出 Top 50 内部的长短差异。
                               宽度用比例条（占 Column3 的百分比），随列宽自适应。 -->
                          <Border Grid.Column="3" Width="76" Height="4" CornerRadius="2"
                                  Background="#232D3B" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}"
                                    Width="{Binding BarWidth}"/>
                          </Border>

                          <TextBlock Grid.Column="4" Text="{Binding Entry.TotalText}" FontSize="13"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextMain}"
                                     VerticalAlignment="Center" MinWidth="66" TextAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <!-- 横向分隔条：拖它改「第一排 / 报告」的高度比 -->
          <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" Background="Transparent"
                        ShowsPreview="False" ResizeDirection="Rows"
                        Cursor="SizeNS" ToolTip="{DynamicResource LocTipSplitH}" x:Name="SplitH">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="Transparent">
                  <Border Height="3" CornerRadius="2" Background="#26313F" x:Name="Grip"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Background" Value="#4CC2FF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>

          <!-- 第二排：游玩时间轴。以月为间隔，每一周画一根柱，柱高 = 当周时长，
               悬停显示那一周玩得最多的游戏与时长。 -->
          <Border Grid.Row="2" Style="{StaticResource StatCard}" Padding="18,14" Margin="0,0,0,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="#60A5FA" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource LocPanelTimeline}" FontSize="15" FontWeight="SemiBold"
                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource LocPanelTimelineSub}" FontSize="12"
                           Foreground="{StaticResource TextFaint}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TimelineSpanText" FontSize="12" Margin="14,0,0,0"
                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- 空态：没有 GameActivity 数据时盖住图表，给出安装指引 -->
              <StackPanel x:Name="TimelineEmptyHint" Grid.Row="1"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="Collapsed" Margin="0,22,0,22">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="30" Foreground="#3A4759" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource LocTimelineNoData}" FontSize="13.5" Margin="0,10,0,0"
                           Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource LocTimelineNoDataHint}" FontSize="12" Margin="0,5,0,0"
                           Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
              </StackPanel>

              <local:TimelineChart x:Name="PlayTimeline" Grid.Row="1" Height="240" Margin="0,12,0,0"/>
            </Grid>
          </Border>

          <!-- 第三排：玩家画像报告 + 推荐 -->
          <Border Grid.Row="3" Style="{StaticResource StatCard}" Padding="18,16" MinHeight="200">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource LocPanelReport}" FontSize="15" FontWeight="SemiBold"
                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="ToneBadge" Background="#1C2634" CornerRadius="4" Padding="6,2"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ToneBadgeText" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                </Border>
                <TextBlock Text="{DynamicResource LocPanelReportSub}" FontSize="12"
                           Foreground="{StaticResource TextFaint}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <ItemsControl x:Name="ReportSections" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <!-- 左侧竖条：用段落自己的强调色，扫一眼就能区分段落 -->
                      <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{Binding Color}"
                              Margin="0,2,13,2"/>

                      <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="17"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,0,11,0"/>

                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="{Binding Body}" FontSize="13" Margin="0,5,0,0"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="21"/>
                      </StackPanel>

                      <!-- 段落关键数字 -->
                      <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Top" MinWidth="76">
                        <TextBlock Text="{Binding Metric}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{Binding Color}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding MetricLabel}" FontSize="11.5"
                                   Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 推荐：同类型的高分好游戏（库内 + AI 库外） -->
              <Border x:Name="RecommendBlock" Margin="0,4,0,0" Padding="0"
                      BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSoft}">
                <StackPanel Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="#34D399" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource LocPanelRecommend}" FontSize="15"
                               FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <!-- AI 状态徽章：绿=AI 已启用 / 灰=未配置 -->
                    <Border x:Name="AiBadge" Background="#1C2634" CornerRadius="4" Padding="6,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AiBadgeDot" Width="6" Height="6" Fill="#6B7A8D"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="AiBadgeText" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <TextBlock x:Name="RecommendSubtitle" FontSize="12" Margin="12,0,0,0"
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 刷新按钮：重新问一次 AI（右下角，避开顶栏窗口按钮区） -->
                    <Button x:Name="AiRefreshButton" Margin="12,0,0,0" Padding="9,3"
                            VerticalAlignment="Center" Cursor="Hand"
                            Style="{StaticResource SegButton}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AiRefreshText" FontSize="11.5" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="AiConfigButton" Margin="8,0,0,0" Padding="9,3"
                            VerticalAlignment="Center" Cursor="Hand"
                            Style="{StaticResource SegButton}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AiConfigText" FontSize="11.5" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- 内联 AI 配置面板（默认收起） -->
                  <Border x:Name="AiConfigPanel" Margin="0,12,0,0" Padding="14,12" CornerRadius="8"
                          Background="#131A24" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}"
                          Visibility="Collapsed">
                    <StackPanel>
                      <TextBlock x:Name="AiConfigTitle" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextMain}"/>
                      <TextBlock x:Name="AiConfigHint" FontSize="11.5" Margin="0,4,0,0"
                                 Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" LineHeight="17"/>

                      <Grid Margin="0,12,0,0" HorizontalAlignment="Left" Width="620">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="AiLabelKey" Grid.Row="0" Grid.Column="0" FontSize="12.5"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox x:Name="AiKeyBox" Grid.Row="0" Grid.Column="1" Height="30"
                                 Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="AiLabelModel" Grid.Row="1" Grid.Column="0" FontSize="12.5"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox x:Name="AiModelBox" Grid.Row="1" Grid.Column="1" Height="30"
                                 Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="AiLabelEndpoint" Grid.Row="2" Grid.Column="0" FontSize="12.5"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox x:Name="AiEndpointBox" Grid.Row="2" Grid.Column="1" Height="30"
                                 Style="{StaticResource FieldBox}"/>
                      </Grid>

                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="AiConfigStatus" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="{StaticResource TextFaint}"/>
                        <Button x:Name="AiSaveButton" Padding="14,5" Cursor="Hand"
                                Style="{StaticResource SegButton}">
                          <TextBlock x:Name="AiSaveText" FontSize="12"/>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- AI 分析中 / 失败提示 -->
                  <TextBlock x:Name="AiStatusLine" FontSize="12" Margin="0,12,0,0"
                             Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                             Visibility="Collapsed"/>

                  <!-- 库内推荐（本地算法，始终显示） -->
                  <StackPanel x:Name="InLibBlock" Margin="0,12,0,0">
                    <TextBlock x:Name="InLibTitle" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDim}"/>
                    <ItemsControl x:Name="RecommendList" Margin="0,9,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="218" Height="84" Margin="0,0,12,12" CornerRadius="8"
                                  Background="#151C26" Padding="11,10">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="42" Height="60" CornerRadius="5"
                                      Background="#0E141C" VerticalAlignment="Top">
                                <Border.Background>
                                  <ImageBrush ImageSource="{Binding Entry.Cover}" Stretch="UniformToFill"
                                              RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                              </Border>
                              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Entry.Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"
                                           LineHeight="16" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Reason}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                           LineHeight="14" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- AI 库外推荐：按类型分组，每组一张横条卡片 -->
                  <StackPanel x:Name="ExternalBlock" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ExternalTitle" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDim}"/>
                    <TextBlock x:Name="ExternalHint" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="ExternalList" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,10" CornerRadius="8" Background="#131A24"
                                  BorderThickness="1" BorderBrush="{StaticResource BorderSoft}"
                                  Padding="13,11">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Background="#1E3A5F" Padding="6,2"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Genre}" FontSize="11.5" FontWeight="SemiBold"
                                             Foreground="#7DB4F0"/>
                                </Border>
                                <TextBlock Text="{Binding Note}" FontSize="11.5" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                              </StackPanel>
                              <ItemsControl ItemsSource="{Binding Games}" Margin="0,9,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#1B2431" CornerRadius="5" Padding="9,4"
                                            Margin="0,0,8,8">
                                      <TextBlock Text="{Binding}" FontSize="12"
                                                 Foreground="{StaticResource TextMain}"/>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- 轻量 Toast：给那些没有状态栏的页面（分析页）做反馈用。
         默认收起，ShowToast() 里淡入 → 停留 → 淡出。 -->
    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center"
            VerticalAlignment="Bottom" Margin="0,0,0,34" Padding="18,11"
            CornerRadius="10" Background="#1B2532" BorderThickness="1"
            BorderBrush="{StaticResource BorderSoft}" Opacity="0" IsHitTestVisible="False"
            Panel.ZIndex="99">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
      </Border.Effect>
      <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource TextMain}"
                 TextWrapping="Wrap" MaxWidth="520"/>
    </Border>
  </Grid>
