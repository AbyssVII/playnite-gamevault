<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GameVault;assembly=GameVault"
    Background="#0B0E14"
    Foreground="#E6EDF3"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

  <UserControl.Resources>

    <!-- ============ 基础色板 ============ -->
    <SolidColorBrush x:Key="BgRoot"      Color="#0B0E14"/>
    <SolidColorBrush x:Key="BgPanel"     Color="#11161F"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161D27"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#1E2734"/>
    <SolidColorBrush x:Key="BorderSoft"  Color="#222B39"/>
    <SolidColorBrush x:Key="TextMain"    Color="#E6EDF3"/>
    <!-- 次要文字（开发商名、时长数值等）。卡片背景 #161D27 上约 12.6:1 -->
    <SolidColorBrush x:Key="TextDim"     Color="#D6DFE9"/>
    <!-- 小标签（"库存总数""总游戏时长""开发商"等）。
         对比度演进：#5A6673（2.89:1，几乎看不清）→ #9AA8B8（6.99:1）→ 现在 #C1CDDB。
         现在：根背景 12.0:1 / 面板 11.2:1 / 卡片 10.5:1；同时全站字号 +1px。 -->
    <SolidColorBrush x:Key="TextFaint"   Color="#C1CDDB"/>
    <SolidColorBrush x:Key="Accent"      Color="#4CC2FF"/>

    <!-- ============ 滚动条 ============ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <!-- 热区占满整条（14px），视觉上只是中间一根细条，好抓取 -->
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Border x:Name="Bar" Background="#39465A" CornerRadius="4"
                                  Width="8" HorizontalAlignment="Center" Margin="0,3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#4CC2FF"/>
                            <Setter TargetName="Bar" Property="Width" Value="10"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#4CC2FF"/>
                            <Setter TargetName="Bar" Property="Width" Value="10"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="14"/>
          <Setter Property="Width" Value="Auto"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter Grid.Column="0"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                         Orientation="Vertical" Style="{StaticResource SlimScrollBar}"
                         Value="{TemplateBinding VerticalOffset}"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 细分隔进度条 ============ -->
    <Style x:Key="TinyBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Background" Value="#1C2530"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="1.5">
              <Grid>
                <Border x:Name="PART_Track" Background="Transparent"/>
                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 细滑块（缩放条） ============ -->
    <Style x:Key="SlimSlider" TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" VerticalAlignment="Center">
              <Border Height="3" CornerRadius="1.5" Background="#2E3A4A" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb Width="13" Height="13" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Fill="#4CC2FF" Width="13" Height="13"/>
                          <Ellipse Fill="#0B0E14" Width="5" Height="5"/>
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 顶部工具按钮 ============ -->
    <Style x:Key="SegButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- 外层透明 Grid：Border 的 CornerRadius 会让四个圆角之外的区域不参与命中测试，
                 套一层透明 Grid 才能做到"整块矩形都可点" -->
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Foreground" Value="#0B0E14"/>
          <Setter Property="Background" Value="{StaticResource Accent}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="1"
                      BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 语言下拉框 ============ -->
    <Style x:Key="LangComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ClickMode" Value="Press"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <!-- 外层透明 Grid：Border 的 CornerRadius 会让圆角之外不参与命中测试，
                 套一层才能做到整个矩形都可点（排序按钮当初就是踩的这个坑） -->
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="#151C26" BorderBrush="{StaticResource BorderSoft}"
                      BorderThickness="1" CornerRadius="6">
                <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="#8593A3" StrokeThickness="1.3"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,0" Padding="9,5">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2735"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#0B0E14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Width" Value="98"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource LangComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Style="{StaticResource LangComboToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     PopupAnimation="Slide" VerticalOffset="3">
                <Border Background="#151C26" BorderBrush="#2C3849" BorderThickness="1"
                        CornerRadius="7" Padding="0,4" MinWidth="98">
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 搜索框 ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#151C26"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="30,0,28,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13" Foreground="{StaticResource TextFaint}"
                           VerticalAlignment="Center" Margin="11,0,0,0"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Hint" Text="{DynamicResource LocSearchHint}" Foreground="{StaticResource TextFaint}"
                           FontSize="13.5" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Text" Value="{x:Null}">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 概览卡片 ============ -->
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgPanel}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
    </Style>

    <!-- ============ 列表容器 ============ -->
    <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 悬停详情内容（网格 / 条形共用） ============ -->
    <DataTemplate x:Key="DetailCardTemplate">
      <Border Width="400" Background="#101720" CornerRadius="12"
              BorderThickness="1" BorderBrush="#2C3849" Padding="0">
        <StackPanel>
          <!-- 海报：完整显示整张图（不裁切），高度随图片比例自适应 -->
          <Border CornerRadius="12,12,0,0" ClipToBounds="True" Background="#0D1219"
                  MinHeight="150" MaxHeight="330">
            <Grid>
              <Image Source="{Binding Poster}" Stretch="Uniform" MaxHeight="330"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <Rectangle Height="90" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#E6101720" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Bottom" Margin="14,0,14,10"
                         TextTrimming="CharacterEllipsis" MaxHeight="46" TextWrapping="Wrap"/>
            </Grid>
          </Border>

          <StackPanel Margin="14,10,14,13">
            <!-- 徽章行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <Border CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                      Background="{Binding ScoreBrush}" Opacity="0.92">
                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0B0E14">
                  <Run Text="Metacritic "/><Run Text="{Binding ScoreText, Mode=OneWay}"/>
                </TextBlock>
              </Border>
              <ItemsControl ItemsSource="{Binding Badges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                            BorderThickness="1" BorderBrush="{Binding Color}">
                      <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{Binding Color}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 开发商 / 发行商。标签列用 Auto 自适应宽度（中文"开发商"窄、英文"Developer"宽），
                 否则英文标签会顶到后面的公司名上 -->
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LocDeveloper}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,0,14,0"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Developers}" FontSize="13" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LocPublisher}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,3,14,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Publishers}" FontSize="13" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </Grid>

            <!-- 时长数据 -->
            <Border Background="#161E29" CornerRadius="8" Padding="11,9" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="{DynamicResource LocTotalTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding TotalLongText}" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Text="{DynamicResource LocRecentTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding RecentLongText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource LocLastPlayed}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding LastPlayedText}" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource LocReleased}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
                  <TextBlock Text="{Binding ReleaseText}" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextDim}"
                       TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 网格卡片 ============ -->
    <DataTemplate x:Key="GameCardTemplate">
      <Border x:Name="CardRoot"
              Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Margin="0,0,10,10"
              Background="{StaticResource BgCard}"
              CornerRadius="9"
              BorderThickness="1"
              BorderBrush="{StaticResource BorderSoft}"
              Cursor="Hand"
              SnapsToDevicePixels="True">
        <Border.ToolTip>
          <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False"
                   Placement="Mouse" HorizontalOffset="16" VerticalOffset="12"
                   ToolTipService.InitialShowDelay="60" ToolTipService.ShowDuration="60000">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailCardTemplate}"/>
          </ToolTip>
        </Border.ToolTip>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="28"/>
          </Grid.RowDefinitions>

          <!-- 封面 -->
          <Border Grid.Row="0" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#0E141C"
                  Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid>
              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextFaint}"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="10"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>

              <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,0,4"
                            Background="#CC0B0E14" BorderThickness="1" BorderBrush="{Binding Color}">
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border CornerRadius="14" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right"
                      Margin="0,6,6,0" Background="#D90B0E14" BorderThickness="1.5" BorderBrush="{Binding ScoreBrush}">
                <TextBlock Text="{Binding ScoreText}" FontSize="13.5" FontWeight="Bold"
                           Foreground="{Binding ScoreBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

            </Grid>
          </Border>

          <!-- 名称 -->
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMain}" Margin="8,7,8,0"
                     TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap"/>

          <!-- 时长行 -->
          <Grid Grid.Row="2" Margin="8,4,8,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="12.5"
                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                  <Setter Property="Text" Value="{DynamicResource LocNotRecently}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRecent}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                      <Setter Property="Text" Value="{Binding RecentText}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <ProgressBar Grid.Row="2" Style="{StaticResource TinyBar}" VerticalAlignment="Bottom"
                       Margin="1,0,1,1" Value="{Binding RecentPercent, Mode=OneWay}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource BgCardHover}"/>
          <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ 条形（列表）行 ============ -->
    <DataTemplate x:Key="BarRowTemplate">
      <Border x:Name="BarRoot"
              Margin="0,0,4,6"
              Background="{StaticResource BgCard}"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{StaticResource BorderSoft}"
              Padding="10,8"
              Cursor="Hand"
              SnapsToDevicePixels="True">
        <Border.ToolTip>
          <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False"
                   Placement="Mouse" HorizontalOffset="16" VerticalOffset="12"
                   ToolTipService.InitialShowDelay="60" ToolTipService.ShowDuration="60000">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailCardTemplate}"/>
          </ToolTip>
        </Border.ToolTip>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="44" Height="58" CornerRadius="5" ClipToBounds="True" Background="#0E141C">
            <Grid>
              <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                         Margin="3" VerticalAlignment="Center" TextAlignment="Center"/>
              <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,5,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0"
                          Background="#150B0E14" BorderThickness="1" BorderBrush="{Binding Color}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Color}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 中间空白区：直接展示开发商 / 发行商 -->
          <TextBlock Grid.Column="2" Text="{Binding DevPubText}" FontSize="12.5"
                     Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                     Margin="22,0,26,0" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource LocRecentTime}" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>
              <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                    <Setter Property="Text" Value="{DynamicResource LocNone}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRecent}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        <Setter Property="Text" Value="{Binding RecentLongText}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ProgressBar Style="{StaticResource TinyBar}" Margin="0,6,0,0"
                         Value="{Binding RecentPercent, Mode=OneWay}"/>
          </StackPanel>

          <Border Grid.Column="4" CornerRadius="17" Width="34" Height="34" VerticalAlignment="Center"
                  Margin="0,0,16,0" Background="#D90B0E14" BorderThickness="1.5"
                  BorderBrush="{Binding ScoreBrush}">
            <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold"
                       Foreground="{Binding ScoreBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Grid.Column="5" Text="{Binding TotalText}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMain}" VerticalAlignment="Center"
                     MinWidth="82" TextAlignment="Right"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="BarRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="BarRoot" Property="Background" Value="{StaticResource BgCardHover}"/>
          <Setter TargetName="BarRoot" Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ 列表面板：网格用换行面板，条形用虚拟化栈 ============ -->
    <ItemsPanelTemplate x:Key="WrapItemsPanel">
      <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="StackItemsPanel">
      <VirtualizingStackPanel/>
    </ItemsPanelTemplate>

  </UserControl.Resources>

  <Grid Background="{StaticResource BgRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 顶部栏 ============ -->
    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSoft}" Padding="16,0">
      <Grid Height="54">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：图标 / 标题 / 计数 / 语言切换。
             这里用 Grid 而不是 StackPanel —— 标题那一列是 *，窗口变窄时它会先被压成省略号，
             整块内容因此永远不会溢出到中间列去遮挡搜索框。
             （用 StackPanel 时内容宽度固定，会盖住中间列，导致语言下拉框点不中。） -->
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="17" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{DynamicResource LocTitle}" FontSize="16.5" FontWeight="SemiBold"
                     Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="2" Background="#1C2634" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding EntryCountText}" FontSize="13" Foreground="{StaticResource TextDim}"/>
          </Border>

          <!-- 语言切换（中文 / English） -->
          <ComboBox Grid.Column="3" x:Name="LanguageBox" Style="{StaticResource LangCombo}" Margin="12,0,0,0"
                    ToolTip="{DynamicResource LocTipLanguage}">
            <ComboBoxItem Content="中文"/>
            <ComboBoxItem Content="English"/>
          </ComboBox>
        </Grid>

        <!-- 搜索 + 排序 + 视图工具：整组居中。
             右侧刻意留空 —— Playnite 自己的最小化/关闭按钮就在窗口右上角，放这儿会重叠。 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" Width="180" Margin="0,0,14,0"/>
          <Border Background="#151C26" CornerRadius="8" Padding="0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SortTotal"  Style="{StaticResource SegButton}" Content="{DynamicResource LocSortTotal}" Tag="Active"/>
              <Button x:Name="SortRecent" Style="{StaticResource SegButton}" Content="{DynamicResource LocSortRecent}"/>
              <Button x:Name="SortScore"  Style="{StaticResource SegButton}" Content="{DynamicResource LocSortScore}"/>
            </StackPanel>
          </Border>
          <Border Width="1" Height="20" Background="{StaticResource BorderSoft}" Margin="12,0"/>
          <Button x:Name="ViewToggleButton" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LocTipList}" Margin="0,0,8,0"/>
          <Button x:Name="ShareButton" Style="{StaticResource IconButton}" Content="&#xE72D;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LocTipShare}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 概览卡片 ============ -->
    <Border Grid.Row="1" Padding="16,12,16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatGames}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding EntryCountText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding RawCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatPlaytime}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding TotalPlaytimeText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding PlayedCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatRecent}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding RecentPlaytimeText}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ActiveCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatTop}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding TopGameName}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding TopGameTimeText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="{DynamicResource LocStatScore}" FontSize="13" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="{Binding AverageScoreText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ScoredCountText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============ 游戏列表 ============ -->
    <Grid Grid.Row="2">
      <ListBox x:Name="GameList"
               Background="Transparent"
               BorderThickness="0"
               Padding="16,0,6,64"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="False"
               ItemContainerStyle="{StaticResource RowItemStyle}"
               HorizontalContentAlignment="Stretch"
               ItemsPanel="{StaticResource WrapItemsPanel}"
               ItemTemplate="{StaticResource GameCardTemplate}"/>

      <TextBlock x:Name="EmptyHint" Text="{DynamicResource LocEmpty}" FontSize="15" Foreground="{StaticResource TextFaint}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

      <Border x:Name="LoadingMask" Background="#F20B0E14" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource LocLoading}" FontSize="15" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,12,0,0" Foreground="{StaticResource Accent}"
                       Background="#1C2530" BorderThickness="0"/>
        </StackPanel>
      </Border>

      <!-- ============ 右下角缩放条 ============ -->
      <Border x:Name="ZoomPanel"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,28,24"
              Height="32"
              Padding="11,0"
              Background="#F0182130"
              CornerRadius="16"
              BorderThickness="1"
              BorderBrush="#33415A"
              Cursor="Hand">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="0.85"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x2212;" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Margin="0,0,8,0" IsHitTestVisible="False"/>
          <Slider x:Name="ZoomSlider"
                  Style="{StaticResource SlimSlider}"
                  Width="122"
                  Minimum="118"
                  Maximum="268"
                  Value="172"
                  SmallChange="4"
                  LargeChange="18"/>
          <TextBlock Text="+" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Margin="8,0,0,0" IsHitTestVisible="False"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ 状态栏 ============ -->
    <Border Grid.Row="3" Background="{StaticResource BgPanel}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSoft}" Padding="16,0">
      <Grid Height="26">
        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SourceText" Text="{Binding SourceText}" FontSize="13" Foreground="{StaticResource TextFaint}"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
