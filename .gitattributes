# 统一换行符，避免 Windows 检出时整个仓库显示为已修改
* text=auto

# C# / XAML：Windows 工具链，统一 CRLF
*.cs     text eol=crlf
*.csproj text eol=crlf
*.xaml   text eol=crlf

# 清单 / 脚本 / CI 配置：跨平台，统一 LF
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.pext binary
*.dll  binary
*.ico  binary
